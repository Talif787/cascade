# Copy to .env and adjust for local development.
CASCADE_ENVIRONMENT=local
CASCADE_LOG_LEVEL=INFO
CASCADE_LOG_JSON=true

CASCADE_HTTP_HOST=0.0.0.0
CASCADE_HTTP_PORT=8000

CASCADE_DATABASE_URL=postgresql+asyncpg://cascade:cascade@localhost:5432/cascade
CASCADE_DATABASE_POOL_SIZE=10
CASCADE_DATABASE_MAX_OVERFLOW=20

CASCADE_REDIS_URL=redis://localhost:6379/0

# Schema registry: leave empty to use the built-in in-memory registry.
# Set to a Confluent-compatible URL to publish schemas externally.
# CASCADE_SCHEMA_REGISTRY_URL=http://localhost:8081
CASCADE_DEFAULT_COMPATIBILITY_MODE=backward

# Ingestion: leave empty to use the built-in in-memory connector runtime.
# Set to a Kafka Connect REST URL to deploy real Debezium / Connect connectors.
# CASCADE_KAFKA_CONNECT_URL=http://localhost:8083

# Stream processing: leave empty to use the built-in in-memory Flink runtime.
# Set the REST URL plus the uploaded job jar id to submit real Flink jobs.
# CASCADE_FLINK_REST_URL=http://localhost:8081
# CASCADE_FLINK_JAR_ID=cascade-jobs.jar
# CASCADE_FLINK_ENTRY_CLASS=com.cascade.jobs.StreamJob

# Lakehouse transformations: leave empty to use the built-in in-memory dbt runtime.
# Set all four to trigger real dbt Cloud job runs.
# CASCADE_DBT_CLOUD_API_URL=https://cloud.getdbt.com
# CASCADE_DBT_CLOUD_ACCOUNT_ID=12345
# CASCADE_DBT_CLOUD_JOB_ID=67890
# CASCADE_DBT_CLOUD_TOKEN=changeme

# Lakehouse orchestration: leave empty to use the built-in in-memory orchestrator.
# Set all three to manage schedules through the Airflow REST API.
# CASCADE_AIRFLOW_API_URL=http://localhost:8080
# CASCADE_AIRFLOW_USERNAME=airflow
# CASCADE_AIRFLOW_PASSWORD=airflow

# Serving: leave empty to use the built-in in-memory ClickHouse runtime, which
# executes analytics queries in process. Set the URL to serve from a real cluster.
# CASCADE_CLICKHOUSE_URL=http://localhost:8123
# CASCADE_CLICKHOUSE_DATABASE=default
# CASCADE_CLICKHOUSE_USERNAME=default
# CASCADE_CLICKHOUSE_PASSWORD=

# Governance: leave the cost source URL empty to use the in-memory cost source.
# Set it to import cost observations from a billing export endpoint.
# CASCADE_COST_SOURCE_URL=https://billing.internal/export
# CASCADE_COST_SOURCE_TOKEN=

# Auth: for local development set CASCADE_AUTH_ENABLED=false to bypass tokens.
CASCADE_AUTH_ENABLED=true
CASCADE_JWT_ALGORITHM=HS256
CASCADE_JWT_SECRET=change-me-in-production
# CASCADE_JWT_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# CASCADE_JWT_ISSUER=https://idp.example.com/
# CASCADE_JWT_AUDIENCE=cascade-control-plane

CASCADE_RATE_LIMIT_ENABLED=true
CASCADE_RATE_LIMIT_PER_MINUTE=120
CASCADE_RATE_LIMIT_BURST=40

CASCADE_OTEL_ENABLED=false
CASCADE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
